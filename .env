# Server Configuration (Nginx akan handle port 80/443)
HTTP_PORT=3000
SMTP_PORT=25
NODE_ENV=production

# Domain Configuration aniyahapp.my.id,jasacode.my.id,rdppromo.site
DOMAINS=aniyahapp.my.id,jasacode.my.id
ALLOWED_ORIGINS=https://aniyahapp.my.id,https://www.aniyahapp.my.id

# Email Settings
MAX_EMAIL_SIZE=10485760
EMAIL_RETENTION_HOURS=24

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
